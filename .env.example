# Database (PostgreSQL — e.g. Neon, Supabase, local Docker)
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL: direct (non-pooled) connection used by prisma db push / migrations.
# For a non-pooled provider, set both to the same value.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth (create at https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# SMTP email (optional — for sending team invite emails).
# If unset, invites fall back to a copy-link flow.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"   # "true" for implicit TLS (port 465)
EMAIL_FROM=""         # defaults to SMTP_USER if unset

# Realtime presence (optional — Phase 5.3 collaborative editing).
# URL of the @thunder/ws-server presence server. If unset, the editor runs
# without live collaborators (feature degrades gracefully).
NEXT_PUBLIC_WS_URL=""            # e.g. https://presence.yourdomain.com
WS_AUTH_SECRET=""                # shared secret; must match the ws-server's WS_AUTH_SECRET

# ws-server only (apps/ws-server) — not read by the web app:
# PORT="4001"
# WS_ALLOW_ORIGIN="http://localhost:3000"

# GitLab provider (optional — Phase 5.2). Host for self-managed GitLab; the
# per-project access token is stored like the GitHub one. Defaults to gitlab.com.
GITLAB_HOST="https://gitlab.com"
